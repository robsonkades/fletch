+    void completedAndFailedPresenceChecksDoNotRetainCursorStateInTheEngine() {
+        final XmlCursorEngine engine = new XmlCursorEngine();
+        final boolean present = engine.extract("<r><before/><after/></r>", doc -> doc.child("r", r -> r.exists("after")));
+        assertTrue(present);
+        assertReleased(engine);
+        assertNull(engine.probeOwner, "a pooled engine must release the cursor and its buffered siblings");
+
+        final IllegalStateException failure = new IllegalStateException("failed after probing");
+        assertSame(failure, assertThrows(IllegalStateException.class, () -> engine.extract("<r/>", doc -> {
+            assertTrue(doc.exists("r"));
+            throw failure;
+        })));
+        assertReleased(engine);
+        assertNull(engine.probeOwner, "exceptional extraction must release probe ownership too");
+        assertEquals("ok", engine.extract("<r><v>ok</v></r>",
+                doc -> doc.child("r", r -> r.value("v", String.class))));
+    }
