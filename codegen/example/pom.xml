<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.robsonkades</groupId>
    <artifactId>fletch-codegen-build</artifactId>
    <version>1.2.0</version>
  </parent>
  <artifactId>fletch-codegen-example</artifactId>
  <name>Fletch codegen consumer and benchmarks</name>
  <dependencies>
    <dependency>
      <groupId>io.github.robsonkades</groupId><artifactId>fletch</artifactId><version>${project.version}</version>
    </dependency>
    <!-- Build tool only; the executable consumer needs just fletch at runtime. -->
    <dependency>
      <groupId>io.github.robsonkades</groupId><artifactId>fletch-codegen</artifactId><version>${project.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.12.2</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId><artifactId>jmh-core</artifactId><version>1.37</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId><artifactId>jmh-generator-annprocess</artifactId><version>1.37</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>../../src/test/resources</directory><includes>
        <include>fixtures/invoice/35240612345678000195550010000274361328488326-procNFe.xml</include>
      </includes></testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path><groupId>org.openjdk.jmh</groupId><artifactId>jmh-generator-annprocess</artifactId><version>1.37</version></path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>compile-mapping-definitions</id><phase>generate-sources</phase><goals><goal>compile</goal></goals>
            <configuration>
              <includes><include>demo/Definitions.java</include><include>demo/NfeDefinition.java</include></includes>
              <proc>none</proc>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.4</version>
        <configuration>
          <mainClass>io.github.robsonkades.fletch.XmlCodegen</mainClass>
          <classpathScope>compile</classpathScope>
          <!-- The preceding compiler execution refreshes Definitions in target/classes. -->
          <sourceRoot>${project.build.directory}/generated-sources/fletch</sourceRoot>
        </configuration>
        <executions>
          <execution><id>generate-nfe</id><phase>generate-sources</phase><goals><goal>java</goal></goals><configuration><arguments>
            <argument>demo.NfeDefinition#mapping</argument><argument>demo.generated.NfeCode</argument><argument>${project.build.directory}/generated-sources/fletch</argument>
          </arguments></configuration></execution>
          <execution><id>generate-order</id><phase>generate-sources</phase><goals><goal>java</goal></goals><configuration><arguments>
            <argument>demo.Definitions#order</argument><argument>demo.generated.OrderCode</argument><argument>${project.build.directory}/generated-sources/fletch</argument>
          </arguments></configuration></execution>
          <execution><id>generate-elements-4</id><phase>generate-sources</phase><goals><goal>java</goal></goals><configuration><arguments>
            <argument>demo.Definitions#elements4</argument><argument>demo.generated.Elements4Code</argument><argument>${project.build.directory}/generated-sources/fletch</argument>
          </arguments></configuration></execution>
          <execution><id>generate-elements-48</id><phase>generate-sources</phase><goals><goal>java</goal></goals><configuration><arguments>
            <argument>demo.Definitions#elements48</argument><argument>demo.generated.Elements48Code</argument><argument>${project.build.directory}/generated-sources/fletch</argument>
          </arguments></configuration></execution>
          <execution><id>generate-attributes-48</id><phase>generate-sources</phase><goals><goal>java</goal></goals><configuration><arguments>
            <argument>demo.Definitions#attributes48</argument><argument>demo.generated.Attributes48Code</argument><argument>${project.build.directory}/generated-sources/fletch</argument>
          </arguments></configuration></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>benchmarks</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId><version>3.7.1</version>
        <executions><execution><id>benchmarks-jar</id><phase>package</phase><goals><goal>single</goal></goals><configuration>
          <finalName>benchmarks</finalName><appendAssemblyId>false</appendAssemblyId><attach>false</attach>
          <descriptors><descriptor>src/assembly/benchmarks.xml</descriptor></descriptors>
          <archive><manifest><mainClass>org.openjdk.jmh.Main</mainClass></manifest></archive>
        </configuration></execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
